rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // Default deny all
    match /{document=**} {
      allow read, write: if false;
    }

    // Connection test document
    match /test/{testId} {
      allow read: if true;
      allow write: if false;
    }

    // User accounts
    match /users/{userId} {
      allow read: if isSignedIn();
      allow write: if isOwner(userId) && isValidId(userId);
    }

    // Player RPG Profiles: Read is public for rankings and character browsing
    match /profiles/{profileId} {
      allow read: if true;
      allow create: if isSignedIn() && isValidId(profileId) && request.resource.data.donoId == request.auth.uid;
      allow update: if isSignedIn() && isValidId(profileId);
      allow delete: if isSignedIn() && isValidId(profileId) && resource.data.donoId == request.auth.uid;
    }

    // Clans: Read is public for guild hall browsing
    match /clans/{clanId} {
      allow read: if true;
      allow write: if isSignedIn() && isValidId(clanId);
    }

    // Dungeon Parties: Read is public for finding active raid lobbies
    match /dungeon_parties/{partyId} {
      allow read: if true;
      allow write: if isSignedIn() && isValidId(partyId);
    }

    // Global Live Feed & Chat Messages
    match /global_messages/{messageId} {
      allow read: if true;
      allow create: if isSignedIn() && isValidId(messageId);
    }
  }
}
